# ---------------------------------------------------------------------------
# jobbot configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Discord ---------------------------------------------------------------
# Create a bot at https://discord.com/developers/applications, enable the
# "applications.commands" and "bot" scopes, and paste the token here.
DISCORD_TOKEN=your-bot-token
# Comma-separated guild ids for instant slash-command sync during development.
# Leave empty in production to sync commands globally (can take up to 1h).
DISCORD_GUILD_IDS=
# Roles (besides server Administrators) allowed to run config commands.
DISCORD_MANAGER_ROLE_IDS=

# --- Database --------------------------------------------------------------
# Default: local SQLite file — zero external services, no Docker needed.
DATABASE_URL=sqlite+aiosqlite:///jobbot.db
# For production / multiple instances, use Postgres instead:
# DATABASE_URL=postgresql+asyncpg://jobbot:jobbot@localhost:5432/jobbot

# Postgres password — REQUIRED by docker-compose.prod.yml, ignored elsewhere.
# Pick a strong value. Postgres bakes it into the data volume on first init.
POSTGRES_PASSWORD=

# --- Search providers ------------------------------------------------------
# Ordered; first with remaining quota is used, the rest are fallbacks.
# Options: serper, bing, brave, google_pse, mock
SEARCH_PROVIDERS=serper
SERPER_API_KEY=
BING_API_KEY=
BRAVE_API_KEY=
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=

# Use the mock provider to exercise the pipeline with no API key:
# SEARCH_PROVIDERS=mock

# --- Listing sources (curated feeds; consume no search-API quota) ----------
# SimplifyJobs internship listings.json. One conditional HTTP request per scan
# (304 when unchanged), so it is cheap and enabled by default.
ENABLE_GITHUB_LISTINGS=true
GITHUB_LISTINGS_URL=https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/.github/scripts/listings.json
# Only ingest postings posted within this many days; 0 = no cutoff (whole feed).
GITHUB_LISTINGS_LOOKBACK_DAYS=30
# SEMICOLON-separated (category names contain commas). Empty = no pre-filter.
GITHUB_LISTINGS_CATEGORIES=Software;Software Engineering;AI/ML/Data;Data Science, AI & Machine Learning

# --- Publish listings to a GitHub README ----------------------------------
# OFF by default: this writes to a repository, i.e. public content.
# Create the target repo yourself, then use a FINE-GRAINED personal access
# token scoped to just that repo with Contents: Read and write.
ENABLE_GITHUB_PUBLISH=false
GITHUB_PUBLISH_TOKEN=
GITHUB_PUBLISH_REPO=            # owner/name
GITHUB_PUBLISH_PATH=README.md
GITHUB_PUBLISH_BRANCH=main
GITHUB_PUBLISH_TITLE=Software Engineering Internships
GITHUB_PUBLISH_LIMIT=200

# --- Quotas / budgets ------------------------------------------------------
DAILY_SEARCH_BUDGET=1000
HOURLY_SEARCH_BUDGET=100
RESULTS_PER_QUERY=10
MAX_QUERIES_PER_SCAN=40

# --- Scheduling ------------------------------------------------------------
SCAN_INTERVAL_HOURS=6
EXPIRATION_RECHECK_HOURS=24
SCAN_ENABLED=true

# --- HTTP / safety ---------------------------------------------------------
HTTP_TIMEOUT_SECONDS=15
HTTP_USER_AGENT=jobbot/0.1 (+https://github.com/example/jobbot)
# Keep false in production to block SSRF to private ranges.
ALLOW_PRIVATE_NETWORKS=false

# --- Relevance -------------------------------------------------------------
DEFAULT_MIN_SCORE=0.55
ENABLE_LLM_CLASSIFICATION=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- Health check ----------------------------------------------------------
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
